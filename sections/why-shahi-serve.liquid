{%- comment -%}
  Why Shahi Serve & Story Section.
  Combines Awadhi Legacy story narration, statistics metrics cards, core benefit cards,
  and the 4-step timeline heritage kitchen process.
{%- endcomment -%}

<!-- 1. Brand Story Section -->
<section class="brand-story-section" id="story">
  <div class="container">
    <span class="section-tagline">{{ section.settings.story_tagline | default: "The Awadhi Legacy" }}</span>
    <h2 class="section-title">{{ section.settings.story_title | default: "A Pantry Revival Worth Savouring" }}</h2>
    
    <div class="heritage-divider">
      <span></span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2zm0 14c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0-7c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm6-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 7c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-12-7c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 7c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
      </svg>
      <span></span>
    </div>
    
    <div class="brand-story-grid">
      <!-- Story Narrative -->
      <div class="story-left animate-on-scroll">
        <h3 class="story-highlight">
          "{{ section.settings.story_highlight | default: "Because 70% of India eats non-veg, yet 90% of packaged food ignores them entirely." }}"
        </h3>
        <div class="story-text-container">
          {{ section.settings.story_desc | default: "<p>We're fixing that, one heritage recipe at a time. Slow-cooked meats, seasoned using original royal family archives, cooked in real ghee with no preservatives.</p>" }}
        </div>
      </div>

      <!-- Stated Statistics Grid -->
      <div class="story-right animate-on-scroll">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat_card' -%}
            <div class="stat-card" {{ block.shopify_attributes }}>
              <div class="stat-number">{{ block.settings.stat_value }}</div>
              <div class="stat-label">{{ block.settings.stat_label }}</div>
              <div class="stat-desc">{{ block.settings.stat_desc }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<!-- 2. Benefits / Feature Cards Section -->
<section class="why-shahi" id="why-us">
  <div class="container">
    <span class="section-tagline">{{ section.settings.benefits_tagline | default: "Why Shahi Serve?" }}</span>
    <h2 class="section-title">{{ section.settings.benefits_title | default: "Crafted with Uncompromising Integrity" }}</h2>
    <p class="section-desc">{{ section.settings.benefits_desc | default: "We combine historical recipes with state-of-the-art food technology to deliver luxury without compromises." }}</p>
    
    <div class="benefits-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'benefit_card' -%}
          <div class="benefit-card animate-on-scroll" {{ block.shopify_attributes }}>
            <div class="benefit-icon">
              {%- if block.settings.icon == 'ghee' -%}
                <!-- Sun/Ghee Icon -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m11.314 11.314l.707.707M12 5a7 7 0 100 14 7 7 0 000-14z" />
                </svg>
              {%- elsif block.settings.icon == 'spices' -%}
                <!-- Spice jar Icon -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
              {%- elsif block.settings.icon == 'shield' -%}
                <!-- Clean Label Shield -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                </svg>
              {%- else -%}
                <!-- Calendar/Time Shelf-life Icon -->
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              {%- endif -%}
            </div>
            <h3 class="benefit-title">{{ block.settings.title }}</h3>
            <p class="benefit-desc">{{ block.settings.desc }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- 3. Heritage Kitchens Timeline Process -->
<section class="heritage-process" id="process">
  <div class="container">
    <span class="section-tagline">{{ section.settings.process_tagline | default: "Our Heritage Process" }}</span>
    <h2 class="section-title">{{ section.settings.process_title | default: "The Journey of Royal Flavours" }}</h2>
    <p class="section-desc">{{ section.settings.process_desc | default: "How we preserve 200-year-old Nawabi kitchen processes inside modern packaged convenience." }}</p>
    
    <div class="timeline">
      {%- assign index_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'process_step' -%}
          {%- assign index_count = index_count | plus: 1 -%}
          <div class="timeline-item animate-on-scroll" {{ block.shopify_attributes }}>
            <div class="timeline-badge">{{ index_count }}</div>
            <div class="timeline-content">
              <span class="timeline-step">Step {{ index_count }}</span>
              <h3 class="timeline-title">{{ block.settings.title }}</h3>
              <p class="timeline-desc">{{ block.settings.desc }}</p>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
