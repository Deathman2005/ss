{%- comment -%}
  Newsletter subscription section for Shahi Serve.
  Allows customer submissions directly to Shopify's Customer database.
{%- endcomment -%}

<section class="newsletter-section-wrapper" style="background-color: {{ section.settings.bg_color | default: 'var(--bg-secondary)' }};">
  <div class="newsletter">
    <div class="container">
      <div class="newsletter-box animate-on-scroll">
        {%- if section.settings.tagline != blank -%}
          <span class="section-tagline">{{ section.settings.tagline }}</span>
        {%- endif -%}
        
        <h2>{{ section.settings.title | default: "Join the Royal Table" }}</h2>
        
        {%- if section.settings.description != blank -%}
          <p>{{ section.settings.description }}</p>
        {%- endif -%}
        
        {%- form 'customer', id: 'newsletter-form', class: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input 
            type="email" 
            name="contact[email]" 
            id="NewsletterEmail-{{ section.id }}"
            class="newsletter-input" 
            value="{{ form.email }}"
            placeholder="{{ section.settings.placeholder | default: 'Enter your email address' }}" 
            aria-label="Email address" 
            required
          >
          <button type="submit" class="btn btn-primary" id="newsletter-submit-{{ section.id }}">
            {{ section.settings.button_text | default: 'Subscribe' }}
          </button>
        {%- endform -%}
        <div class="newsletter-msg" id="newsletter-msg" role="alert"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .newsletter-section-wrapper {
    border-top: 1px solid rgba(183, 140, 46, 0.1);
    border-bottom: 1px solid rgba(183, 140, 46, 0.1);
    padding: 80px 0;
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Section Tagline",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Join the Royal Table"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "Subscribe to receive 200-year-old culinary stories, secret recipe reveals, and 15% off your first luxury feast."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1d1956"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Signup"
    }
  ]
}
{% endschema %}
