{%- comment -%}
  Hero Banner section for Shahi Serve storefront.
  Contains responsive typography, background configurations, customizable badges, CTA controls, and floating image displays.
{%- endcomment -%}

<section class="hero-section" id="hero" style="
  {% if section.settings.bg_image != blank %}
    background-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}');
  {% else %}
    background-color: {{ section.settings.bg_color | default: 'var(--bg-primary)' }};
  {% endif %}
">
  <div class="container">
    <div class="hero-grid">
      <!-- Text Content -->
      <div class="hero-content animate-on-scroll">
        <h1 class="hero-headline">
          {{ section.settings.title | default: "India's Heritage <br><span class=\"text-gold\">Non-Veg Cuisine</span>, Reimagined" }}
        </h1>
        
        {%- if section.settings.subheadline != blank -%}
          <p class="hero-subheadline">
            {{ section.settings.subheadline }}
          </p>
        {%- endif -%}

        <div class="hero-ctas">
          {%- if section.settings.cta_text != blank -%}
            <a href="{{ section.settings.cta_link | default: '#products' }}" class="btn btn-primary" id="hero-cta-shop">
              {{ section.settings.cta_text }}
            </a>
          {%- endif -%}
          {%- if section.settings.secondary_cta_text != blank -%}
            <a href="{{ section.settings.secondary_cta_link | default: '#story' }}" class="btn btn-secondary" id="hero-cta-explore">
              {{ section.settings.secondary_cta_text }}
            </a>
          {%- endif -%}
        </div>
        
        <!-- Interactive badges -->
        <div class="hero-badge-container">
          {%- for block in section.blocks -%}
            {%- if block.type == 'badge' -%}
              <div class="hero-badge" {{ block.shopify_attributes }}>
                {%- if block.settings.icon == 'clean' -%}
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                  </svg>
                {%- elsif block.settings.icon == 'clock' -%}
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 22c5.52 0 10-4.48 10-10S17.52 2 12 2 2 6.48 2 12s4.48 10 10 10zm1-17h-2v6H6v2h7V5z"/>
                  </svg>
                {%- endif -%}
                <span>{{ block.settings.label }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <!-- Featured Product Visual Floating Card -->
      <div class="hero-visual-card animate-on-scroll">
        {%- if section.settings.featured_image != blank -%}
          <img 
            src="{{ section.settings.featured_image | image_url: width: 800 }}" 
            alt="{{ section.settings.featured_image.alt | default: 'Featured delicacy' }}"
            width="500"
            height="400"
          >
        {%- else -%}
          <!-- Placeholder SVG or fallback static asset -->
          <img src="{{ 'hero_banner.png' | asset_url }}" alt="Featured delicacy fallback" onerror="this.src='https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-collection-2_1024x1024.png'">
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "max_blocks": 3,
  "settings": [
    {
      "type": "html",
      "id": "title",
      "label": "Headline",
      "default": "India's Heritage <br><span class=\"text-gold\">Non-Veg Cuisine</span>, Reimagined"
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Zero Preservatives. Zero Additives. Real Ghee. Whole Spices. Authentic 200-Year-Old Recipes."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Link Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link URL"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Text",
      "default": "Explore Our Story"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA URL"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fallback Background Color",
      "default": "#282272"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Visual Card Image"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Feature Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Badge Icon",
          "options": [
            { "value": "clean", "label": "Clean Label (Info)" },
            { "value": "clock", "label": "Clock (Time)" }
          ],
          "default": "clean"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Badge Text",
          "default": "100% Clean Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "clean",
            "label": "100% Clean Label"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "clock",
            "label": "Ready in 2 Mins"
          }
        }
      ]
    }
  ]
}
{% endschema %}
