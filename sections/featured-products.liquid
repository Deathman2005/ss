{%- comment -%}
  Featured Products / Storefront section for Shahi Serve.
  Enables dynamic collections selection, tab filtering, and product-card inclusions.
{%- endcomment -%}

<section class="featured-products" id="products">
  <div class="container">
    <span class="section-tagline">{{ section.settings.tagline | default: "Discover the Shahi Table" }}</span>
    <h2 class="section-title">{{ section.settings.title | default: "The Royal Storefront" }}</h2>
    {%- if section.settings.description != blank -%}
      <p class="section-desc">{{ section.settings.description }}</p>
    {%- endif -%}

    <!-- Dynamic Category Tabs -->
    {%- assign tab_blocks = section.blocks | where: "type", "collection_tab" -%}
    {%- if tab_blocks.size > 0 -%}
      <div class="product-tabs animate-on-scroll">
        {%- for block in tab_blocks -%}
          <button 
            type="button"
            class="tab-btn {% if forloop.first %}active{% endif %}" 
            data-tab-target="tab-content-{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label | default: collections[block.settings.collection].title | default: 'Delicacy' }}
          </button>
        {%- endfor -%}
      </div>

      <!-- Rendered Product Grids for each Tab -->
      {%- for block in tab_blocks -%}
        {%- assign current_collection = collections[block.settings.collection] -%}
        {%- assign limit = section.settings.limit | default: 6 -%}
        <div 
          class="products-grid tab-content {% if forloop.first %}active{% else %}hidden-tab{% endif %}" 
          id="tab-content-{{ block.id }}"
        >
          {%- if current_collection.products.size > 0 -%}
            {%- for product in current_collection.products limit: limit -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback Mock Cards if Collection is Empty (useful during onboarding) -->
            {%- for i in (1..3) -%}
              <div class="product-card animate-on-scroll">
                <div class="product-image-container">
                  <span class="product-badge">Bestseller</span>
                  {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
                <div class="product-info">
                  <h3 class="product-title">Royal Mutton Dish {{ i }}</h3>
                  <p class="product-description">Slow-cooked mutton in rich traditional Kashmiri spices, real ghee, and bone-marrow gravy.</p>
                  <div class="product-footer">
                    <span class="price-current">₹349</span>
                    <button type="button" class="product-add-btn">Add</button>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <!-- Default fallback layout if no blocks are defined (renders collections.all) -->
      <div class="products-grid">
        {%- assign default_collection = collections[section.settings.collection] | default: collections.all -%}
        {%- if default_collection.products.size > 0 -%}
          {%- for product in default_collection.products limit: 6 -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..6) -%}
            <div class="product-card animate-on-scroll">
              <div class="product-image-container">
                <span class="product-badge">Bestseller</span>
                {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              <div class="product-info">
                <h3 class="product-title">Royal Mutton Rogan Josh</h3>
                <p class="product-description">Slow-cooked mutton in rich traditional Kashmiri spices, real ghee, and bone-marrow gravy.</p>
                <div class="product-footer">
                  <span class="price-current">₹349</span>
                  <button type="button" class="product-add-btn">+</button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .hidden-tab {
    display: none !important;
  }
  .products-grid.tab-content {
    animation: fadeIn 0.5s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Section Tagline",
      "default": "Discover the Shahi Table"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "The Royal Storefront"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Subtitle",
      "default": "Experience India’s finest slow-cooked meats, seasoned to perfection using original royal family archives."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Default Fallback Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 3,
      "max": 12,
      "step": 3,
      "label": "Products Limit per Tab",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "Collection Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab Label (e.g. Heat & Eat)",
          "info": "Leave blank to use Collection Title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "blocks": [
        {
          "type": "collection_tab",
          "settings": {
            "label": "All Delicacies"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "label": "Heat & Eat Curries"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "label": "Ready-to-Cook Kebabs"
          }
        }
      ]
    }
  ]
}
{% endschema %}
