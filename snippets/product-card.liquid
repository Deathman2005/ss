{% comment %}
  Renders a premium product card for Shahi Serve storefront.
  Accepts:
  - product: {Object} Shopify Product object
  Usage:
  {% render 'product-card', product: product %}
{% endcomment %}

{%- assign first_variant = product.first_available_variant -%}

<div class="product-card animate-on-scroll">
  <div class="product-image-container">
    {%- comment -%} Determine badges from tags or custom settings {%- endcomment -%}
    {%- assign badge_text = blank -%}
    {%- for tag in product.tags -%}
      {%- if tag == 'Bestseller' or tag == 'Trending' or tag == 'Signature' or tag == 'Popular' or tag == 'Limited' -%}
        {%- assign badge_text = tag -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if badge_text != blank -%}
      <span class="product-badge">{{ badge_text }}</span>
    {%- endif -%}

    <a href="{{ product.url }}" aria-label="View {{ product.title }}">
      {%- if product.featured_image != blank -%}
        <img 
          src="{{ product.featured_image | image_url: width: 600 }}" 
          alt="{{ product.featured_image.alt | escape }}" 
          loading="lazy" 
          width="450" 
          height="380"
        >
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>
  </div>

  <div class="product-info">
    <div class="product-meta">
      <span class="product-category">{{ product.type | default: 'Heritage Kitchens' }}</span>
      <div class="product-rating">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
        </svg>
        <span>4.9</span>
      </div>
    </div>

    <h3 class="product-title">
      <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">{{ product.title }}</a>
    </h3>
    
    <p class="product-description">{{ product.description | strip_html | truncate: 120 }}</p>

    <!-- Specifications list dynamically read from product tags prefixed with "spec_" -->
    <div class="product-specs">
      {%- assign spec_count = 0 -%}
      {%- for tag in product.tags -%}
        {%- if tag contains 'spec_' -%}
          {%- assign spec_count = spec_count | plus: 1 -%}
          <span class="spec-tag">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            {{ tag | remove: 'spec_' | replace: '_', ' ' }}
          </span>
        {%- endif -%}
      {%- endfor -%}
      
      {%- if spec_count == 0 -%}
        <!-- Default fallback specs if none defined via tags -->
        <span class="spec-tag">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Serves 2
        </span>
        <span class="spec-tag">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          100% Ghee
        </span>
      {%- endif -%}
    </div>

    <div class="product-footer">
      <div class="product-price">
        <span class="price-current">{{ product.price | money_without_trailing_zeros }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="price-compare">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
        {%- endif -%}
      </div>

      {%- if first_variant.available -%}
        <button 
          type="button" 
          class="product-add-btn" 
          onclick="addToCartAJAX({{ first_variant.id }}, this)" 
          aria-label="Add {{ product.title }} to bag"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
        </button>
      {%- else -%}
        <button type="button" class="product-add-btn" disabled style="background: var(--text-muted); cursor: not-allowed;" aria-label="Sold Out">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="20" height="20">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
          </svg>
        </button>
      {%- endif -%}
    </div>
  </div>
</div>
